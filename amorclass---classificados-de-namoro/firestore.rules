rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classified listings
    match /listings/{listingId} {
      allow read, write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
